# ============================================
# IAsConta — Environment Configuration
# ============================================
# Copy this file to backend/.env and fill in the values
# Never commit backend/.env to git
#
# Secrets used by docker-compose.yml via ${VAR} substitution
# (JWT_SECRET, BOT_API_KEY, EVOLUTION_WEBHOOK_SECRET, PLUGGY_WEBHOOK_SECRET,
# CORS_ORIGINS) must ALSO exist in the .env file at the project ROOT.

# === REQUIRED ===
# JWT secret for token generation (use: openssl rand -hex 32)
JWT_SECRET=change-me-to-a-random-64-char-string

# Bot API key for internal service communication (use: openssl rand -hex 16)
BOT_API_KEY=change-me-bot-key

# Dedicated webhook secrets (server does NOT start without them)
EVOLUTION_WEBHOOK_SECRET=  # openssl rand -hex 16 — must match Evolution API WEBHOOK_GLOBAL_HEADERS
PLUGGY_WEBHOOK_SECRET=     # openssl rand -hex 16 — must match webhooks registered on Pluggy

# === DATABASE ===
DATABASE_URL=postgresql://postgres:<password>@postgres:5432/contas?schema=public

# === PORTS ===
PORT=3001

# === WHATSAPP (Evolution API) ===
EVOLUTION_API_URL=http://evolution-api:8080
EVOLUTION_API_KEY=secret_api_key
WHATSAPP_INSTANCE_NAME=contas
WHATSAPP_GROUP_ID=  # optional: restrict bot to one group

# === AI (Groq for NLP + financial agent) ===
GROQ_API_KEY=  # your Groq API key (https://console.groq.com)
GROQ_MODEL=llama-3.3-70b-versatile

# === BOT ===
# WhatsApp phone is linked automatically on first message (via QR code scan)
# Or manually via POST /api/whatsapp-users
# Couple names (person detection) are configured PER USER in the web panel (/setup)

# === OPEN FINANCE (Pluggy — optional, per-user via /setup) ===
PLUGGY_CLIENT_ID=
PLUGGY_CLIENT_SECRET=

# === CORS (optional) ===
# Comma-separated list of allowed origins
CORS_ORIGINS=https://iasconta.jesielpfeifer.com,http://iasconta.jesielpfeifer.com

# === DISCORD (optional) ===
DISCORD_TOKEN=

# === TELEGRAM (optional) ===
TELEGRAM_TOKEN=

# === GOOGLE GEMINI (optional) ===
GEMINI_API_KEY=

# === EMAIL (optional) ===
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM=IAsConta <noreply@iasconta.local>
